tags = PackedStringArray("DARTS", "Escalate")
instruction = "一条 TALL 上升斜线把玩家一路抬到中位（36→96→152→200）。到顶之后不是让他落回来，而是用 HIGH_LOW 高位封锁接住他：中位双镖此时正处在上升轨迹的顶点上，玩家必须立刻压住、不能再跳；随后低位双镖才轮到起跳。这是全地图第一次明确要求「爬到高处之后马上改判成低轨迹」。之后一条 SHORT 下降线把玩家送回地面，末尾用低位双镖收尾。"
parameters = {
"speed": 180.0,
"patterns": [
{"kind": "RISE", "shape": "TALL", "start": 0.8},
{"kind": "HIGH_LOW", "breath": 0.00},
{"kind": "FALL", "shape": "SHORT", "breath": 0.00},
{"kind": "HINT", "count": 2, "breath": 0.08}
]
}
