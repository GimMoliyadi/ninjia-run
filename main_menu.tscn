horizontal_alignment = 1

[node name="Title" type="Label" parent="Center/Panel/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.96, 0.9, 1)
theme_override_font_sizes/font_size = 48
text = "水墨忍者"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Panel/Margin/Content"]
